#!/bin/bash
# Pre-commit hook: inspect staged blobs for secrets and large files.

set -u
HAS_ERROR=0

while IFS= read -r -d '' FILE; do
    # Skip the hook itself (contains the detection patterns).
    if [[ "$FILE" == ".githooks/pre-commit" || "$FILE" == ".git/hooks/pre-commit" ]]; then
        continue
    fi

    # Inspect exactly what is staged, not a later working-tree version.
    if git show ":$FILE" 2>/dev/null | grep -aqiE '(api[_-]?key\s*=|secret\s*=|token\s*=|ghp_|github_pat_)'; then
        echo "POSSIBLE SECRET DETECTED in $FILE"
        HAS_ERROR=1
    fi

    SIZE=$(git cat-file -s ":$FILE" 2>/dev/null) || {
        echo "Unable to inspect staged file: $FILE"
        HAS_ERROR=1
        continue
    }
    if [ "$SIZE" -gt 10485760 ] 2>/dev/null; then
        SIZE_MB=$((SIZE / 1048576))
        echo "Large file staged: $FILE ($SIZE_MB MB > 10MB limit)"
        HAS_ERROR=1
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$HAS_ERROR" -eq 1 ]; then
    echo ""
    echo "=== PRE-COMMIT CHECK FAILED ==="
    echo "Fix the issues above or use: git commit --no-verify"
    echo ""
    exit 1
fi

echo "Pre-commit checks passed."
exit 0
