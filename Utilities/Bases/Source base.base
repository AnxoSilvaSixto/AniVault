filters:
  and:
    - "!Rating.isEmpty()"
views:
  - type: table
    name: Manga
    filters:
      and:
        - Source == link("Manga")
    order:
      - file.name
      - Studio
      - Episodes
      - Aired
    sort: []
    columnSize:
      file.name: 271
      note.Studio: 182
      note.Episodes: 75
  - type: table
    name: 4-koma manga
    filters:
      and:
        - Source == link("4-koma manga")
