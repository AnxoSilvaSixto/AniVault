filters:
  and:
    - "!Rating.isEmpty()"
views:
  - type: table
    name: Action
    filters:
      and:
        - Genre.contains(link("Action"))
    order:
      - file.name
      - Studio
      - Episodes
      - Aired
    sort: []
    columnSize:
      file.name: 271
      note.Studio: 182
      note.Episodes: 75
