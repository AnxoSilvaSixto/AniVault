filters:
  and:
    - "!Rating.isEmpty()"
views:
  - type: table
    name: Shonen
    filters:
      and:
        - Demographic == link("Shounen")
    order:
      - file.name
      - Studio
      - Episodes
      - Aired
    sort: []
    columnSize:
      file.name: 271
      note.Studio: 182
      note.Episodes: 75
