filters:
  and:
    - "!Rating.isEmpty()"
views:
  - type: table
    name: Shounen
    filters:
      and:
        - Demographic.contains(link("Shounen"))
    order:
      - file.name
      - Studio
      - Episodes
      - Aired
    sort: []
    columnSize:
      file.name: 271
      note.Studio: 182
      note.Episodes: 75
