# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Explicit text types (UTF-8, LF)
*.md text working-tree-encoding=UTF-8 eol=lf
*.canvas text eol=lf
*.json text eol=lf
*.base text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
