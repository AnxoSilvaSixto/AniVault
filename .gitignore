# Obsidian vault .gitignore

# --- Vault state (volatile / machine-specific) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/hotkeys.json
# Vault-inspector scan cache (local state, broken-link detection)
.obsidian/plugins/vault-inspector/data.json

# Plugin/theme code is version-controlled; only caches ignored above

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
.env

# Logs
*.log

# Generated update outputs (manual review only)
Utilities/Scripts/data/Metadata_Updates/
Utilities/Scripts/data/Studio_Updates/

# Temp
*.tmp
*.bak

# opencode leftover (should live at .opencode/ or ~/.config/opencode, not inside .git/)
.git/opencode
