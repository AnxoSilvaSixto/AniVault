# AniVault — local environment template (tracked, no secrets).
# Copy to .env (gitignored) and fill in your own key:
#   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Scripts load VAULT_ROOT/.env automatically via load_dotenv()
# without overriding real environment variables.
# Never commit .env — the pre-commit hook blocks API keys/tokens.

# Tenrai API server key (optional but recommended for full refresh).
# Public tier:  120 requests/minute, 4/second.
# Server tier: 300/minute, 5/second (with key set).
# Until this is set, use --dry-run + pytest/validate_vault offline;
# live `sync_anime.py --full` / `sync_studios.py --full` stay rate-limited
# and 401/403 auth failures are NOT retried (see tier_banner()).
TENRAI_SERVER_KEY=
